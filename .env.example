# NeoVax-Agent Environment Variables

# === Database ===
NEOVAX_DATABASE_URL=sqlite:///./neovax.db
# For PostgreSQL: postgresql://user:***@localhost:5432/neovax

# === Local runtime ports / CORS ===
NEOVAX_API_PORT=8010
NEOVAX_DASHBOARD_PORT=8502
# JSON list parsed by pydantic-settings.
NEOVAX_CORS_ORIGINS=["http://localhost:8502","http://127.0.0.1:8502","http://localhost:3000"]

# === Background job backend ===
# Determines how background jobs are dispatched.
#   auto        – use Celery if a broker URL is configured, otherwise threadpool (default)
#   threadpool  – always use the in-process thread-pool executor (safe for local dev)
#   celery      – always use Celery; fails at dispatch time if no broker is reachable
NEOVAX_BACKGROUND_JOB_BACKEND=auto

# === Optional worker stack (Celery + Redis) ===
# Uncomment ONLY if you are running the worker profile (see OPERATOR_GUIDE.md).
#
# When these are set AND the worker/redis containers are running, background
# jobs (pipeline, AlphaFold) will be dispatched through Celery workers.
# When they are unset or the containers are down, the app automatically falls
# back to its built-in threadpool — no configuration change needed.
#
# NEOVAX_REDIS_URL=redis://localhost:6379/0
# NEOVAX_CELERY_BROKER_URL=redis://localhost:6379/0
# NEOVAX_CELERY_RESULT_BACKEND=redis://localhost:6379/1
#
# For Docker Compose (worker profile), use the internal host:
# NEOVAX_REDIS_URL=redis://redis:6379/0
# NEOVAX_CELERY_BROKER_URL=redis://redis:6379/0
# NEOVAX_CELERY_RESULT_BACKEND=redis://redis:6379/1

# === Species Mode ===
# Options: demo | dog | human
NEOVAX_SPECIES_MODE=demo

# === Cloud Upload ===
NEOVAX_CLOUD_UPLOAD_ENABLED=false
NEOVAX_CLOUD_UPLOAD_CONFIRMATION_REQUIRED=true

# === Encryption ===
NEOVAX_ENCRYPTION_AT_REST_ENABLED=false
# NEOVAX_ENCRYPTION_KEY=changeme-set-a-real-key

# === AlphaFold ===
NEOVAX_ALPHAFOLD_DEFAULT_BACKEND=mock
# NEOVAX_COLABFOLD_PATH=/path/to/localcolabfold
# NEOVAX_AF2_PATH=/path/to/alphafold2
# NEOVAX_AF3_PATH=/path/to/alphafold3

# === Logging ===
NEOVAX_LOG_LEVEL=INFO
NEOVAX_STRUCTURED_LOGS=true
NEOVAX_AUDIT_LOG_PATH=./audit_logs

# === Safety ===
NEOVAX_SAFETY_PREFLIGHT_ENABLED=true
NEOVAX_UNSAFE_TEXT_SCANNER_ENABLED=true

# === Secret Key ===
NEOVAX_SECRET_KEY=change...-key