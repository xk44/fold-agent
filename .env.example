# FoldAgent Environment Variables

# === Database ===
FOLDAGENT_DATABASE_URL=sqlite:///./foldagent.db
# For PostgreSQL: postgresql://user:***@localhost:5432/foldagent

# === Local runtime ports / CORS ===
FOLDAGENT_API_PORT=8010
FOLDAGENT_DASHBOARD_PORT=8502
# JSON list parsed by pydantic-settings.
FOLDAGENT_CORS_ORIGINS=["http://localhost:8502","http://127.0.0.1:8502","http://localhost:3000"]

# === Background job backend ===
# Determines how background jobs are dispatched.
#   auto        – use Celery if a broker URL is configured, otherwise threadpool (default)
#   threadpool  – always use the in-process thread-pool executor (safe for local dev)
#   celery      – always use Celery; fails at dispatch time if no broker is reachable
FOLDAGENT_BACKGROUND_JOB_BACKEND=auto

# === Optional worker stack (Celery + Redis) ===
# Uncomment ONLY if you are running the worker profile (see OPERATOR_GUIDE.md).
#
# When these are set AND the worker/redis containers are running, background
# jobs (pipeline, AlphaFold) will be dispatched through Celery workers.
# When they are unset or the containers are down, the app automatically falls
# back to its built-in threadpool — no configuration change needed.
#
# FOLDAGENT_REDIS_URL=redis://localhost:6379/0
# FOLDAGENT_CELERY_BROKER_URL=redis://localhost:6379/0
# FOLDAGENT_CELERY_RESULT_BACKEND=redis://localhost:6379/1
#
# For Docker Compose (worker profile), use the internal host:
# FOLDAGENT_REDIS_URL=redis://redis:6379/0
# FOLDAGENT_CELERY_BROKER_URL=redis://redis:6379/0
# FOLDAGENT_CELERY_RESULT_BACKEND=redis://redis:6379/1

# === Species Mode ===
# Options: demo | dog | human
FOLDAGENT_SPECIES_MODE=demo

# === Cloud Upload ===
FOLDAGENT_CLOUD_UPLOAD_ENABLED=false
FOLDAGENT_CLOUD_UPLOAD_CONFIRMATION_REQUIRED=true

# === Encryption ===
FOLDAGENT_ENCRYPTION_AT_REST_ENABLED=false
# FOLDAGENT_ENCRYPTION_KEY=changeme-set-a-real-key

# === AlphaFold ===
FOLDAGENT_ALPHAFOLD_DEFAULT_BACKEND=mock
# FOLDAGENT_COLABFOLD_PATH=/path/to/localcolabfold
# FOLDAGENT_AF2_PATH=/path/to/alphafold2
# FOLDAGENT_AF3_PATH=/path/to/alphafold3

# === Logging ===
FOLDAGENT_LOG_LEVEL=INFO
FOLDAGENT_STRUCTURED_LOGS=true
FOLDAGENT_AUDIT_LOG_PATH=./audit_logs

# === Safety ===
FOLDAGENT_SAFETY_PREFLIGHT_ENABLED=true
FOLDAGENT_UNSAFE_TEXT_SCANNER_ENABLED=true

# === Secret Key ===
FOLDAGENT_SECRET_KEY=change...-key